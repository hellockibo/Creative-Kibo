# Example configuration values for local development
# Rename this file to .env and replace the placeholder values.

VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
# Leave empty for same-origin deployments; set this to the deployed server URL when the API is separate.
VITE_API_URL=
CLIENT_URL=http://localhost:5173
PORT=5000
